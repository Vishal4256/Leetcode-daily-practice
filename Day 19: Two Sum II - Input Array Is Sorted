class Solution {
    public int[] twoSum(int[] num, int t) {
        int n=num.length;
        int l=0;
        int r=n-1;
        int[] ans=new int[2];
        while(n/2>0){
            if(num[l]+num[r]==t){
                ans[0] = l+1;
                ans[1] = r+1;
            }
            else{
                if(num[r] + num[l]>t){
                    r--;
                }else{
                    l++;
                }
            }
            n--;
        }
        return ans;
    }
}
