class Solution {
    public boolean stoneGame(int[] p) {
        int n=p.length;
        int m=n;
        int a=0;
        int b=0;
        for(int i=0;i<n/2;i++){
            if(p[i]+p[i+1]>=p[n-(i+1)]+p[n-(i+1)]){
                if(p[i]<=p[n-(i+1)]){
                    b+=p[i];
                    a+=p[n-(i+1)];
                }
                else{
                    a+=p[i];
                    b+=p[n-(i+1)];
                }
            }
        }
        return a>=b;       
    }
}
