class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        Arrays.sort(nums);
        int n=nums.length;
        ArrayList<Integer> ans=new ArrayList<>();
        for(int i=nums[0];i<=nums[n-1];i++){
            int a=0;
            for(int j=0;j<n;j++){
                if(i==nums[j]){
                    a=1;
                }
            }
            if(a==0){
                ans.add(i);
            }
        }
        return ans;
    }
}
