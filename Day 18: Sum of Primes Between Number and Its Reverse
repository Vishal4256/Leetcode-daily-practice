class Solution{
    public boolean isPrime(int x){
        if(x<=1){
            return false;
        }
        for(int i=2;i*i<=x;i++){
            if(x%i==0){
                return false;
            }
        }
        return true;
    }
    public int sumOfPrimesInRange(int n){
        int a=n;
        int b=0;
        while(n!=0){
            int rem=n%10;
            b=b*10+rem;
            n=n/10;
        }
        int sum=0;
        if(a<b){
            for(int i=a;i<=b;i++){
                if(isPrime(i)){
                    sum+=i;
                }
            }
        }else{
            for(int i=b;i<=a;i++){
                if(isPrime(i)){
                    sum+=i;
                }
            }
        }
        return sum;
    }
}
