class Solution {
    public int smallestNumber(int n, int t) {
        int m=n;
        int ans=0;
        for(int i=0;i<100;i++){
            m=n+i;
            int mul=1;
            while(m>0){
                mul*=m%10;
                m/=10;
            }
            if(mul%t==0){
                ans=n+i;
                break;
            }
        }
        return ans;
    }
}
