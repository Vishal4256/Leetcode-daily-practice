class Solution {
    public String intToRoman(int num) {
        String rn="";
        int[] nr={1000,900,500,400,100,90,50,40,10,9,5,4,1};
        String[] romn={"M","CM","D","CD","C","XC","L","XL","X","IX","V","IV","I"};
        for(int i=0;i<nr.length;i++){
            while(num>=nr[i]){
                rn+=romn[i];
                num-=nr[i];
            }
        }
        return rn;
    }
}
