class Solution {
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {
        ListNode ans=new ListNode(0);
        ListNode l=ans;
        int r=0;
        while(l1!=null || l2!=null){
            int x=(l1!=null) ? l1.val:0;
            int y=(l2!=null) ? l2.val:0;
            int sum=x+y+r;
            r=sum/10;
            l.next=new ListNode(sum%10);
            l=l.next;
            if(l1!=null)
                l1=l1.next;
            if(l2!=null)
                l2=l2.next;
        }
        if(r!=0)
            l.next=new ListNode(r);
        return ans.next;
    }
}
